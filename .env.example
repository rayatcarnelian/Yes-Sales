# Copy to .env and fill only the values you actually have.
# Empty integration keys keep that adapter in mock or not_configured mode.
# local and test may use the built-in development passwords.
# Any other value, including a forgotten setting, is production and refuses those passwords.
YES_SALES_ENV=local

# App database role (subject to row-level security)
DATABASE_URL=postgresql+psycopg://yes_app:yes_app@127.0.0.1:5432/yes_sales
# Migration role. Local Docker superuser. Never ship this to a browser.
ADMIN_DATABASE_URL=postgresql+psycopg://yes:yes@127.0.0.1:5432/yes_sales
APP_DB_PASSWORD=yes_app

JWT_SECRET=replace-with-a-long-random-string
JWT_TTL_MINUTES=720
WEBHOOK_SECRET=replace-with-a-long-random-string
SCHEDULER_TOKEN=replace-with-a-long-random-string
VOICE_GATEWAY_TOKEN=replace-with-a-long-random-string

# Live outbound email is off until you set this true AND configure SMTP.
OUTBOUND_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# xAI. Leave blank to keep the Grok model not_configured.
# This key calls the model. It does not control Grok credits, and it is not the database password.
XAI_API_KEY=
XAI_MODEL=grok-4.7
# Optional door for a Grok bot to POST one import. Leave blank to keep the door closed.
# Put a long random string here. Never put the database password or the founder password here.
GROK_BOT_TOKEN=
XAI_REALTIME_URL=wss://api.x.ai/v1/realtime

# Twilio. Leave blank until a voice number and auth token exist.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
PUBLIC_VOICE_HOST=

# Supabase Auth is used only when both values are set.
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# Local seed passwords. Change them. These are not production secrets.
DEV_FOUNDER_EMAIL=founder@yes-sales.test
DEV_FOUNDER_PASSWORD=change-me-founder
DEV_OPERATOR_EMAIL=operator@yes-sales.test
DEV_OPERATOR_PASSWORD=change-me-operator

CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
API_INTERNAL_URL=http://127.0.0.1:8000
AUTO_MIGRATE=true
UPLOAD_DIR=data/uploads
