# This machine only. Copy to .env for local uvicorn or loopback Docker Compose.
# Do not use this file on a public host. It keeps the built-in development passwords.
YES_SALES_ENV=local

# App database role (subject to row-level security)
DATABASE_URL=postgresql+psycopg://yes_app:yes_app@127.0.0.1:5432/yes_sales
# Migration role. Local superuser. Never ship this to a browser.
ADMIN_DATABASE_URL=postgresql+psycopg://yes:yes@127.0.0.1:5432/yes_sales
APP_DB_PASSWORD=yes_app

JWT_SECRET=replace-with-a-long-random-string
JWT_TTL_MINUTES=720
WEBHOOK_SECRET=replace-with-a-long-random-string
SCHEDULER_TOKEN=replace-with-a-long-random-string
VOICE_GATEWAY_TOKEN=replace-with-a-long-random-string

OUTBOUND_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

XAI_API_KEY=
XAI_MODEL=grok-4.7
GROK_BOT_TOKEN=
XAI_REALTIME_URL=wss://api.x.ai/v1/realtime

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
PUBLIC_VOICE_HOST=

SUPABASE_URL=
SUPABASE_JWT_SECRET=

DEV_FOUNDER_EMAIL=founder@yes-sales.test
DEV_FOUNDER_PASSWORD=change-me-founder
DEV_OPERATOR_EMAIL=operator@yes-sales.test
DEV_OPERATOR_PASSWORD=change-me-operator

CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
API_INTERNAL_URL=http://127.0.0.1:8000
AUTO_MIGRATE=true
UPLOAD_DIR=data/uploads
